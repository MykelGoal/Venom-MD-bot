# ────────────────────────────────────────────────────────────────
#  VENOM MD — environment
# ────────────────────────────────────────────────────────────────

# ★ REQUIRED — short ID from the pairing site (looks like VENOM-K7M2-9XPQ)
SESSION_ID=

# ★ REQUIRED — your phone number (international, no +).
OWNER_NUMBER=2348012345678  # replace with YOUR number

# Session site URL is BAKED in settings.js. Users do not set this.
# SESSION_API=

PREFIX=.

AI_PROVIDER=gemini
GEMINI_API_KEY=

DATABASE_URL=
ANTI_LINK=true
WELCOME=true
AUTO_READ=false
FORCE_WEBSOCKET=true
PORT=3000
LOG_LEVEL=info
REPO_URL=https://github.com/MykelGoal/Venom-MD-bot

# ── YOUTUBE (optional) ───────────────────────────────────────────
# .song/.yt work WITHOUT cookies on most hosts. If YouTube ever
# demands login from your host's IP, set ONE of these:
#  a) YT_COOKIES — base64 of a cookies.txt exported from a logged-in
#     browser (ext: "Get cookies.txt LOCALLY"). Wins over the feed.
#  b) (automatic) — if your session site serves GET /yt-cookie, the bot
#     fetches your cookie at startup and refreshes it every 6h on its
#     own. Deployers never set anything for this. YT_COOKIE_KEY is only
#     needed if you lock the endpoint (set it on the session site AND here).
YT_COOKIES=
YT_COOKIE_KEY=
# YT_COOKIE_API=          # default: your session site /yt-cookie
# YT_COOKIE_REFRESH_MS=   # default: 6h (min 60s)
# Advanced: extra yt-dlp args, space-separated:
# YT_DLP_EXTRA_ARGS=

# ── ANTI-SLEEP (keeps free hosts awake) ───────────────────────────
# Render/Railway: nothing to do — the bot auto-detects its public URL
# (RENDER_EXTERNAL_URL / RAILWAY_PUBLIC_DOMAIN) and self-pings /health
# every 10 minutes. Anywhere else, set your public URL:
KEEPALIVE_URL=
# KEEPALIVE_INTERVAL_MS=600000   # default: 10 minutes (never < 60s)
